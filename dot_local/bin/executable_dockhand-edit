#!/usr/bin/env bash
#
# dockhand-edit — edit a file inside a Dockhand-managed container or
# volume using your local $EDITOR instead of the web GUI.
#
# Requires: curl, jq
#
# Auth: Dockhand is assumed to sit behind Authelia ForwardAuth. Rather than
# scraping a browser session cookie (short-lived, single-login), this uses
# a dedicated Authelia service account over HTTP Basic Auth, per Authelia's
# own guide for scripted access:
# https://www.authelia.com/integration/guides/securing-apps-with-basic-auth/
#
# Config (env vars):
#   DOCKHAND_URL       e.g. https://dockhand.example.com
#   DOCKHAND_USER      Authelia service account username
#   DOCKHAND_PASSWORD  Authelia service account password

set -euo pipefail

# $0 reflects whatever name the script was invoked as (dockhand-edit,
# dockhand-edit.sh, a symlink name, etc.), so usage text always matches
# reality instead of a hardcoded filename.
PROG="$(basename "$0")"

usage() {
  cat >&2 <<EOF
Usage:
  ${PROG} container <container_id>  <path/in/container>  [--env ENV_ID]
  ${PROG} volume    <volume_name>   <path/in/volume>     [--env ENV_ID]

Arguments:
  MODE      Required. Must be exactly 'container' or 'volume'.
  TARGET    Required. Container ID (container mode) or volume name (volume mode).
  PATH      Required. Absolute path to the file inside the container/volume.

Options:
  --env ENV_ID   Dockhand environment id. Required if your Dockhand
                 instance manages more than one environment; otherwise
                 omit it to use the default. Can appear anywhere in the
                 argument list.
  -h, --help     Show this help and exit.

Examples:
  ${PROG} container a1b2c3d4  /app/config.json
  ${PROG} container a1b2c3d4  /app/config.json  --env prod
  ${PROG} volume    my_data   /data/settings.yaml --env staging

Required environment variables:
  DOCKHAND_URL       e.g. https://dockhand.example.com
  DOCKHAND_USER      Authelia service account username
  DOCKHAND_PASSWORD  Authelia service account password

Optional environment variables:
  EDITOR              defaults to 'vi'
  DOCKHAND_EDITOR_MODE  'gui' or 'terminal', overrides auto-detection of
                        whether to wait for a manual confirmation (needed
                        for GUI editors like zed/code whose --wait can be
                        unreliable) or block on the editor process (normal
                        for terminal editors like vim/nano)
EOF
}

# Scan all args for --env / -h / --help first, order-independent, so
# `--env prod` can appear before, after, or between the positional args.
# Whatever's left over becomes the positional list.
POSITIONAL=()
ENV_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --env)
      if [[ $# -lt 2 || "$2" == -* ]]; then
        echo "Error: --env requires a value." >&2
        usage
        exit 2
      fi
      ENV_ID="$2"
      shift 2
      ;;
    --env=*)
      ENV_ID="${1#--env=}"
      if [[ -z "$ENV_ID" ]]; then
        echo "Error: --env requires a value." >&2
        usage
        exit 2
      fi
      shift
      ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -*)
      echo "Error: unknown option '$1'." >&2
      usage
      exit 2
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done
set -- "${POSITIONAL[@]}"

# Validate argument *count* first, with a specific message per failure mode,
# rather than letting bash's generic "unbound variable" error fire — that
# error doesn't say which argument was missing or what the expected shape is.
if [[ $# -eq 0 ]]; then
  echo "Error: no arguments given." >&2
  usage
  exit 2
fi

MODE="$1"

if [[ "$MODE" != "container" && "$MODE" != "volume" ]]; then
  echo "Error: invalid mode '${MODE}' (must be 'container' or 'volume')." >&2
  usage
  exit 2
fi

if [[ $# -lt 3 ]]; then
  echo "Error: '${MODE}' mode requires 3 positional arguments, got $#." >&2
  usage
  exit 2
fi

if [[ $# -gt 3 ]]; then
  echo "Error: too many positional arguments (expected 3, got $#: ${*})." >&2
  usage
  exit 2
fi

TARGET="$2"
FPATH="$3"
EDITOR="${EDITOR:-vi}"

missing_env=()
[[ -z "${DOCKHAND_URL:-}" ]] && missing_env+=("DOCKHAND_URL")
[[ -z "${DOCKHAND_USER:-}" ]] && missing_env+=("DOCKHAND_USER")
[[ -z "${DOCKHAND_PASSWORD:-}" ]] && missing_env+=("DOCKHAND_PASSWORD")

if [[ ${#missing_env[@]} -gt 0 ]]; then
  echo "Error: missing required environment variable(s): ${missing_env[*]}" >&2
  usage
  exit 2
fi

# Defensive: strip any trailing CR/LF that a secrets backend or template
# might leave on a value (e.g. a CLI tool's stdout retaining its newline
# when substituted verbatim into a template rather than via command
# substitution). A stray newline in a Basic Auth username/password fails
# with a confusing 401 rather than an obvious parse error, so it's worth
# guarding here even though the real fix belongs in the secrets pipeline.
DOCKHAND_URL="${DOCKHAND_URL%$'\r'}"; DOCKHAND_URL="${DOCKHAND_URL%$'\n'}"
DOCKHAND_USER="${DOCKHAND_USER%$'\r'}"; DOCKHAND_USER="${DOCKHAND_USER%$'\n'}"
DOCKHAND_PASSWORD="${DOCKHAND_PASSWORD%$'\r'}"; DOCKHAND_PASSWORD="${DOCKHAND_PASSWORD%$'\n'}"

# Strip any trailing slash(es) so URL-building below never produces
# "//api/..." — a loop rather than a single ${VAR%/} in case the value
# has more than one (e.g. a URL field with a stray double slash).
while [[ "$DOCKHAND_URL" == */ ]]; do
  DOCKHAND_URL="${DOCKHAND_URL%/}"
done

ENV_QS=""
if [[ -n "$ENV_ID" ]]; then
  ENV_QS="&env=$(jq -rn --arg s "$ENV_ID" '$s|@uri')"
fi

curl_json() {
  curl -sS -u "${DOCKHAND_USER}:${DOCKHAND_PASSWORD}" "$@"
}

# Performs a GET and separates the HTTP status from the body so failures
# (auth, 404, etc.) get a clear message instead of feeding an error page
# or empty body into jq and getting a cryptic parse error.
# On success, prints the raw response body to stdout.
http_get() {
  local url="$1"
  local raw status body
  raw="$(curl -sS -u "${DOCKHAND_USER}:${DOCKHAND_PASSWORD}" -w '\n%{http_code}' "$url")"
  status="${raw##*$'\n'}"
  body="${raw%$'\n'*}"
  if [[ ! "$status" =~ ^2 ]]; then
    echo "Error: GET ${url} failed with HTTP ${status}" >&2
    echo "Response body:" >&2
    echo "$body" >&2
    exit 1
  fi
  printf '%s' "$body"
}

# Pure bash/jq URL-encoding, avoids a python3 dependency.
urlencode() {
  jq -rn --arg s "$1" '$s|@uri'
}

case "$MODE" in
  container)
    CONTAINER_ID="$TARGET"
    READ_URL="${DOCKHAND_URL}/api/containers/${CONTAINER_ID}/files/content?path=$(urlencode "$FPATH")${ENV_QS}"
    WRITE_URL="$READ_URL"
    ;;
  volume)
    VOLUME_NAME="$TARGET"
    # Trigger the volume browse first so a helper container exists,
    # and grab its id so we can write through the container endpoint.
    BROWSE_URL="${DOCKHAND_URL}/api/volumes/${VOLUME_NAME}/browse?path=$(urlencode "$(dirname "$FPATH")")${ENV_QS}"
    BROWSE_BODY="$(http_get "$BROWSE_URL")"
    HELPER_ID="$(printf '%s' "$BROWSE_BODY" | jq -r '.helperId // empty')"
    if [[ -z "$HELPER_ID" ]]; then
      echo "Error: could not find .helperId in the volume browse response." >&2
      echo "Response body:" >&2
      echo "$BROWSE_BODY" >&2
      exit 1
    fi
    ENC_PATH="$(urlencode "$FPATH")"
    READ_URL="${DOCKHAND_URL}/api/volumes/${VOLUME_NAME}/browse/content?path=${ENC_PATH}${ENV_QS}"
    WRITE_URL="${DOCKHAND_URL}/api/containers/${HELPER_ID}/files/content?path=${ENC_PATH}${ENV_QS}"
    ;;
esac

TMP="$(mktemp --suffix="-$(basename "$FPATH")")"
trap 'rm -f "$TMP"' EXIT

echo "Fetching ${FPATH} ..."
READ_BODY="$(http_get "$READ_URL")"

# Dockhand's own docs say the file-content endpoint returns
# {"content": "...", "path": "..."}, but note their docs are
# AI-generated and may not match a given instance/version exactly.
# Try that shape first; if the body isn't JSON with a .content field
# (e.g. this endpoint streams the raw file instead), fall back to
# treating the whole response body as the file content itself.
if CONTENT="$(printf '%s' "$READ_BODY" | jq -er '.content' 2>/dev/null)"; then
  printf '%s' "$CONTENT" > "$TMP"
else
  printf '%s' "$READ_BODY" > "$TMP"
fi

CHECKSUM_BEFORE="$(sha256sum "$TMP" | awk '{print $1}')"

# EDITOR is often a command plus flags (e.g. "zeditor --wait", "code --wait"),
# so it has to be split into an argv array rather than invoked as a single
# quoted token — "$EDITOR" "$TMP" would otherwise look for a binary literally
# named "zeditor --wait" and fail with "command not found".
read -ra EDITOR_ARGV <<< "$EDITOR"
if [[ ${#EDITOR_ARGV[@]} -eq 0 ]]; then
  echo "Error: \$EDITOR is empty." >&2
  exit 1
fi
if ! command -v "${EDITOR_ARGV[0]}" >/dev/null 2>&1; then
  echo "Error: editor command '${EDITOR_ARGV[0]}' not found on \$PATH." >&2
  echo "(EDITOR=\"${EDITOR}\")" >&2
  exit 1
fi

# GUI editors with a single-instance architecture (Zed, VS Code, Cursor,
# Sublime, etc.) don't reliably block on their own --wait flag when an
# instance is already running — Zed in particular has an open upstream bug
# for exactly this (zed-industries/zed#54203). Rather than trust the process
# exit to mean "done editing", launch these in the background and wait for
# an explicit confirmation instead. Terminal editors (vim, nano, ...) still
# run in the foreground and block naturally, which is more convenient when
# it works. DOCKHAND_EDITOR_MODE=gui|terminal overrides the auto-detection.
GUI_EDITORS=(code code-insiders cursor zed zeditor subl sublime_text atom gedit kate)
EDITOR_BASENAME="$(basename "${EDITOR_ARGV[0]}")"
EDITOR_MODE="${DOCKHAND_EDITOR_MODE:-}"

if [[ -z "$EDITOR_MODE" ]]; then
  EDITOR_MODE="terminal"
  for g in "${GUI_EDITORS[@]}"; do
    if [[ "$EDITOR_BASENAME" == "$g" ]]; then
      EDITOR_MODE="gui"
      break
    fi
  done
fi

if [[ "$EDITOR_MODE" == "gui" ]]; then
  "${EDITOR_ARGV[@]}" "$TMP" >/dev/null 2>&1 &
  disown
  echo "Opened in ${EDITOR_BASENAME}. This editor's --wait can't be trusted to block"
  echo "(especially if it was already running), so confirm manually instead."
  read -rp "Press Enter here once you've saved and closed ${FPATH}: " _
else
  "${EDITOR_ARGV[@]}" "$TMP"
fi

CHECKSUM_AFTER="$(sha256sum "$TMP" | awk '{print $1}')"

if [[ "$CHECKSUM_BEFORE" == "$CHECKSUM_AFTER" ]]; then
  echo "No changes made — not writing back."
  exit 0
fi

echo "Writing changes back to ${FPATH} ..."
CONTENT_JSON="$(jq -Rs '{content: .}' < "$TMP")"

WRITE_RAW="$(curl -sS -X PUT \
  -u "${DOCKHAND_USER}:${DOCKHAND_PASSWORD}" \
  -H "Content-Type: application/json" \
  -d "$CONTENT_JSON" \
  -w '\n%{http_code}' \
  "$WRITE_URL")"
WRITE_STATUS="${WRITE_RAW##*$'\n'}"
WRITE_BODY="${WRITE_RAW%$'\n'*}"

if [[ ! "$WRITE_STATUS" =~ ^2 ]]; then
  echo "Error: PUT ${WRITE_URL} failed with HTTP ${WRITE_STATUS}" >&2
  echo "Response body:" >&2
  echo "$WRITE_BODY" >&2
  echo "Your local edits are preserved at: ${TMP}" >&2
  trap - EXIT   # keep the temp file around so nothing is lost
  exit 1
fi

printf '%s\n' "$WRITE_BODY" | jq . 2>/dev/null || printf '%s\n' "$WRITE_BODY"

echo "Done."
