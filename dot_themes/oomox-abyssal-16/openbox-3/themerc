# @TODO: finish replacing the colors here


# Menu
menu.border.color: #CCFFFF

menu.title.bg: Solid Flat
menu.title.bg.color: #1F1F3D
menu.title.bg.shadow: 0
menu.title.text.color: #CCFFFF
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #1F1F3D
menu.items.text.color: #CCFFFF
menu.items.disabled.text.color: #a0c7ce

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #0066FF
menu.items.active.text.color: #CCFFFF

menu.separator.color: #a0c7ce
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #1F1F3D

# Active window
window.active.border.color: #0066FF


window.active.title.bg: flat solid
window.active.title.bg.color: #1F1F3D
window.active.title.separator.color: #1F1F3D
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #CCFFFF

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1F1F3D

window.active.grip.bg: flat solid
window.active.grip.bg.color: #1F1F3D

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #1F1F3D
window.active.button.unpressed.image.color: #CCFFFF

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #0066FF
window.active.button.pressed.image.color: #FFFFFF

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #1F1F3D
window.active.button.disabled.image.color: #a0c7ce

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1F1F3D
window.active.button.hover.image.color: #0066FF

#window.active.button.toggled.bg: #0066FF
#window.active.button.toggled.image.color: #FFFFFF

# Inactive window
window.inactive.border.color: #333366

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1F1F3D
window.inactive.title.separator.color: #1F1F3D
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #a0c7ce

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #1F1F3D

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #1F1F3D

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #1F1F3D
window.inactive.button.unpressed.image.color: #a0c7ce

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #0066FF
window.inactive.button.pressed.image.color: #FFFFFF

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #a0c7ce
window.inactive.button.disabled.image.color: #1F1F3D

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #1F1F3D
window.inactive.button.hover.image.color: #0066FF


# OSD
osd.border.width: 1
osd.border.color: #0066FF

osd.bg: flat solid
osd.bg.color: #1F1F3D
osd.label.bg: flat solid
osd.label.bg.color: #1F1F3D
osd.label.text.color: #CCFFFF

# OSD
osd.bg: Solid Flat
osd.bg.color: #1F1F3D
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #0066FF
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #262647

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #333399
#osd.button.unpressed.*.border.color: #CCFFFF

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #0066FF
#osd.button.pressed.*.border.color: #FFFFFF

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #CCFFFF
#osd.button.focused.*.border.color: #262647

osd.button.focused.box.color: #0066FF


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
