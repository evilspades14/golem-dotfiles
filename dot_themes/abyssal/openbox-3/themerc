# Menu
menu.border.color: #333366

menu.title.bg: Solid Flat
menu.title.bg.color: #006699
menu.title.bg.shadow: 0
menu.title.text.color: #b5b5f8
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #006699
menu.items.text.color: #b5b5f8
menu.items.disabled.text.color: #87a1e0

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #0099ff
menu.items.active.text.color: #b5b5f8

menu.separator.color: #87a1e0
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #006699

# Active window
window.active.border.color: #0099ff


window.active.title.bg: flat solid
window.active.title.bg.color: #006699
window.active.title.separator.color: #006699
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #b5b5f8

window.active.handle.bg: flat solid
window.active.handle.bg.color: #006699

window.active.grip.bg: flat solid
window.active.grip.bg.color: #006699

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #006699
window.active.button.unpressed.image.color: #b5b5f8

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #0099ff
window.active.button.pressed.image.color: #333366

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #006699
window.active.button.disabled.image.color: #87a1e0

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #006699
window.active.button.hover.image.color: #0099ff

#window.active.button.toggled.bg: #0099ff
#window.active.button.toggled.image.color: #333366

# Inactive window
window.inactive.border.color: #006699

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #006699
window.inactive.title.separator.color: #006699
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #87a1e0

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #006699

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #006699

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #006699
window.inactive.button.unpressed.image.color: #87a1e0

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #0099ff
window.inactive.button.pressed.image.color: #333366

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #87a1e0
window.inactive.button.disabled.image.color: #006699

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #006699
window.inactive.button.hover.image.color: #0099ff


# OSD
osd.border.width: 1
osd.border.color: #0099ff

osd.bg: flat solid
osd.bg.color: #006699
osd.label.bg: flat solid
osd.label.bg.color: #006699
osd.label.text.color: #b5b5f8

# OSD
osd.bg: Solid Flat
osd.bg.color: #006699
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #0099ff
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #000000

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #0066ff
#osd.button.unpressed.*.border.color: #6666cc

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #0099ff
#osd.button.pressed.*.border.color: #333366

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #333366
#osd.button.focused.*.border.color: #000000

osd.button.focused.box.color: #0099ff


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
